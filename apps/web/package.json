{
  "name": "@mercado/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:biome": "biome lint .",
    "lint:biome:fix": "biome lint --write .",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:fix": "pnpm run lint:biome:fix && pnpm run lint:eslint:fix",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:integration": "playwright test --config=playwright-integration.config.ts",
    "test:integration:ui": "playwright test --config=playwright-integration.config.ts --ui",
    "test:integration:report": "playwright show-report tests-integration/playwright-report",
    "msw:init": "msw init public --save"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mercado/api-contracts": "workspace:*",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "@tanstack/react-query": "^5.90.21",
    "@ts-rest/core": "catalog:",
    "@ts-rest/react-query": "^3.52.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "^1.58.2",
    "@types/node": "catalog:",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "msw": "^2.15.0",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "typescript7": "catalog:",
    "vite": "^7.3.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
