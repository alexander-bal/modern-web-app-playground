#!/bin/sh

# Fix PATH for GUI Git clients (SourceTree, GitHub Desktop, etc.)

# Load nvm if available
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# Add common Node.js installation paths as a fallback, after nvm's own PATH entries
export PATH="$PATH:/usr/local/bin:/opt/homebrew/bin"

# Enable corepack to ensure pnpm is available
command -v corepack >/dev/null 2>&1 && corepack enable 2>/dev/null

echo "Applying test database migrations..."
# DATABASE_URL is forced here because a dev .env (loaded by drizzle.config.ts) takes
# precedence over the NODE_ENV=test default, so it would otherwise send these
# migrations to the dev database instead of the test one.
DATABASE_URL="postgresql://user:password@localhost:5432/mercado_test" \
  pnpm --filter @mercado/backend db:migrate:test || {
  echo "❌ Test database migration failed. Fix the migration before pushing."
  exit 1
}

echo "Checking spelling..."
pnpm spell || {
  echo "❌ Spell check failed. Fix the errors or run 'pnpm spell:fix' before pushing."
  exit 1
}

echo "Checking lint..."
pnpm lint || {
  echo "❌ Lint failed. Fix the errors or run 'pnpm lint:fix' to auto-fix."
  exit 1
}

echo "Auditing dependencies..."
# --ignore-registry-errors keeps a registry outage from failing the push as if it had found
# vulnerabilities; the audit in ci.yml stays strict and is the authoritative gate.
pnpm audit --audit-level moderate --ignore-registry-errors || {
  echo "❌ Vulnerable dependencies found. Upgrade them, or record an accepted advisory under 'audit.ignore' in pnpm-workspace.yaml."
  exit 1
}

echo "Building all packages..."
pnpm build || {
  echo "❌ Build failed. Fix the errors or run 'pnpm build' to reproduce."
  exit 1
}

echo "Detecting dead code..."
pnpm knip || {
  echo "❌ Dead code detected. Remove the unused files, exports, and dependencies before pushing."
  exit 1
}

echo "Running unit tests..."
pnpm test || {
  echo "❌ Unit tests failed. Fix the failing tests before pushing."
  exit 1
}
