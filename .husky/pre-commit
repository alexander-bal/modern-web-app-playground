#!/bin/sh

# Fix PATH for GUI Git clients (SourceTree, GitHub Desktop, etc.)

# Load nvm if available
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# Add common Node.js installation paths
export PATH="/usr/local/bin:/opt/homebrew/bin:$PATH"

# Enable corepack to ensure pnpm is available
command -v corepack >/dev/null 2>&1 && corepack enable 2>/dev/null

# Staged paths are listed one per line and NUL-fed to xargs so paths with spaces survive
staged=$(git diff --cached --name-only --diff-filter=ACMR)

# Format staged files only
if [ -n "$staged" ]; then
  printf '%s\n' "$staged" | tr '\n' '\0' |
    xargs -0 pnpm biome format --write --no-errors-on-unmatched --files-ignore-unknown=true
fi
git update-index --again

echo "Checking Biome lint..."
if [ -n "$staged" ]; then
  printf '%s\n' "$staged" | tr '\n' '\0' |
    xargs -0 pnpm biome lint --no-errors-on-unmatched --files-ignore-unknown=true || {
    echo "❌ Biome lint failed. Fix the errors or run 'pnpm lint:biome:fix' to auto-fix."
    exit 1
  }
fi

# ESLint runs per package so it resolves each package's own flat config
echo "Checking ESLint..."
for pkg in backend web; do
  pkg_files=$(printf '%s\n' "$staged" | grep -E "^apps/$pkg/.*\.(ts|tsx)$" | sed "s|^apps/$pkg/||" || true)
  if [ -n "$pkg_files" ]; then
    printf '%s\n' "$pkg_files" | tr '\n' '\0' |
      xargs -0 pnpm --filter "@mercado/$pkg" exec eslint --max-warnings 0 --no-warn-ignored || {
      echo "❌ ESLint check failed. Fix the errors or run 'pnpm lint:eslint:fix' to auto-fix."
      exit 1
    }
  fi
done

# Type coverage check
echo "Running TypeScript type check..."
pnpm typecheck || {
  echo "❌ TypeScript type check failed. Fix the TypeScript errors or run 'pnpm typecheck' to reproduce."
  exit 1
}

echo "Checking type coverage..."
pnpm type-coverage || {
  echo "❌ Type coverage check failed. Current coverage is below the required 97%."
  echo "Run 'pnpm type-coverage:detail' to see which files need better type coverage."
  exit 1
}
